area = rectangle(length, breadth)

print("Area of Rectangle:", area)

#Create a function to calculate the factorial of a number.
def factorial(num):
    result = 1

    for i in range(1, num + 1):
        result = result * i

    return result

num = int(input("Enter a number: "))

if num >= 0:
    print("Factorial:", factorial(num))
else:
    print("Factorial is not defined for negative numbers")

#Create a function that accepts marks and returns Pass or Fail.
def check_result(marks):
    if marks >= 40:
        return "Pass"
    else:
        return "Fail"

marks = int(input("Enter student marks: "))

print("Student Result:", check_result(marks))

#Create a function that accepts marks and returns the student's grade.
def calculate_grade(marks):
    if marks >= 80 and marks <= 100:
        return "Grade A"
    elif marks >= 60:
        return "Grade B"
    elif marks >= 40:
        return "Grade C"
    elif marks >= 0:
        return "Fail"
    else:
        return "Invalid Marks"

marks = int(input("Enter student marks: "))

print("Student Grade:", calculate_grade(marks))
