#Find the highest marks from a dictionary.
def highest_marks(students):
    return max(students.values())

students = {"Rahul": 85, "Amit": 90, "Priya": 95}

print("Highest Marks:", highest_marks(students))

#Count the number of passed students.
def passed_students(students):
    count = 0

    for marks in students.values():
        if marks >= 40:
            count = count + 1

    return count

students = {"Rahul": 85, "Amit": 35, "Priya": 75}

print("Passed Students:", passed_students(students))

