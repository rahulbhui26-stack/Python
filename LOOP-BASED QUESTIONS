#Print numbers from 1 to 10
for i in range(1, 11):
    print(i)

#Print numbers from 10 to 1
for i in range(10, 0, -1):
    print(i)

#Print all even numbers from 1 to 20
for i in range(1, 21):
    if i % 2 == 0:
        print(i)

#Print all odd numbers from 1 to 20
for i in range(1, 21):
    if i % 2 != 0:
        print(i)

#Take two numbers from the user and print all even numbers between them
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

for i in range(a, b + 1):
    if i % 2 == 0:
        print(i)

#Take two numbers from the user and print all odd numbers between them
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

for i in range(a, b + 1):
    if i % 2 != 0:
        print(i)

#Take a number from the user and print its multiplication table
num = int(input("Enter a number: "))

for i in range(1, 11):
    print(num, "x", i, "=", num * i)

#Find the sum of numbers from 1 to 10
total = 0

for i in range(1, 11):
    total = total + i

print("Sum:", total)

#Take two numbers and find the sum of all numbers between them
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

total = 0

for i in range(a, b + 1):
    total = total + i

print("Sum:", total)

#Take two numbers and print all numbers divisible by 6 between them
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

for i in range(a, b + 1):
    if i % 6 == 0:
        print(i)

#Take two numbers and print all numbers that are even and divisible by 6
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

for i in range(a, b + 1):
    if i % 2 == 0 and i % 6 == 0:
        print(i)

#Take two numbers and print all numbers that are odd and divisible by 3
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

for i in range(a, b + 1):
    if i % 2 != 0 and i % 3 == 0:
        print(i)

#Find the factorial of a given number
num = int(input("Enter a number: "))

factorial = 1

for i in range(1, num + 1):
    factorial = factorial * i

print("Factorial:", factorial)

