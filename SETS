#Create a set containing 5 numbers.
numbers = {10, 20, 30, 40, 50}

print("Set:", numbers)

#Add a new element using add().
numbers = {10, 20, 30, 40, 50}

numbers.add(60)

print("Updated Set:", numbers)

#Remove an element using remove().
numbers = {10, 20, 30, 40, 50}

numbers.remove(30)

print("Updated Set:", numbers)

#Check whether an element exists in a set.
numbers = {10, 20, 30, 40, 50}

value = int(input("Enter a number: "))

if value in numbers:
    print("Element exists in the set")
else:
    print("Element does not exist in the set")

#Create two sets and find their union.
set1 = {10, 20, 30, 40}
set2 = {30, 40, 50, 60}

result = set1.union(set2)

print("Union:", result)

#Create two sets and find their intersection.
set1 = {10, 20, 30, 40}
set2 = {30, 40, 50, 60}

result = set1.intersection(set2)

print("Intersection:", result)

#Create two sets and find their difference.
set1 = {10, 20, 30, 40}
set2 = {30, 40, 50, 60}

result = set1.difference(set2)

print("Difference:", result)

#Create a set containing duplicate numbers and observe the result.
numbers = {10, 20, 30, 20, 40, 30, 50}

print("Set:", numbers)

#Given two sets of student names, find students present in both sets.
class1 = {"Rahul", "Amit", "Rohit", "Sumit"}
class2 = {"Amit", "Rohit", "Ankit", "Vikas"}

result = class1.intersection(class2)

print("Students Present in Both Classes:", result)

#Given two sets of students, find students who are present in the first class but not in the second class.
class1 = {"Rahul", "Amit", "Rohit", "Sumit"}
class2 = {"Amit", "Rohit", "Ankit", "Vikas"}

result = class1.difference(class2)

print("Students Only in First Class:", result
